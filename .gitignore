# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore .meta files: Unity uses them to track asset GUIDs.
# Ignoring one breaks references for everyone who pulls the repo.
!/[Aa]ssets/**/*.meta

# Asset Store tools plugin (not used)
/[Aa]ssets/AssetStoreTools*

# Autogenerated Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache
.vs/
.gradle/
ExportedObj/
.consulo/

# Autogenerated solution and project files.
# Unity regenerates these on project open; they cause merge conflicts
# because they list absolute paths.
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity generated binaries and debug symbols (build output only)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Steam Deck / Proton
steamapps/
proton/
*.AppImage
*.flatpak

# Donut Quest: local build output
/Builds_*
/Distro/
